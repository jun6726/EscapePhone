      "screenFlow": ["convenience_store_intro","convenience_store_home","receipt_price","barcode_rule","shelf_difference","cctv_sequence","inventory_crosscheck","customer_pattern","incident_timeline","convenience_store_final_decision","convenience_store_ending"],
      "stages": ["not_started","intro_completed","receipt_solved","barcode_solved","shelf_difference_solved","cctv_solved","inventory_solved","customer_pattern_solved","timeline_solved","game_completed"],
      "story": [
        "플레이어는 지인의 부탁을 받고 새벽 편의점 근무를 대신 맡는다.",
        "오전 2시 17분이 되자 매장 전원이 꺼지고, 다시 켜졌을 때 시계는 오전 2시로 돌아가 있다.",
        "같은 17분이 반복되지만 매 반복마다 상품 위치, 판매 기록, CCTV 속 행동이 조금씩 달라진다.",
        "과거 이 편의점에서 한 손님(윤서진)이 실종되었고, 점장(박재현)이 사건 기록을 숨긴 것으로 보인다.",
        "실제로는 편의점 야간 관리 시스템이 실종 사건 당시의 센서, POS, CCTV, 출입 기록을 반복 재생하고 있다.",
        "윤서진은 편의점 물류 시스템을 이용한 불법 거래를 발견했고, 박재현은 그를 피신시키고 증거를 보존하려 했다.",
        "본사는 박재현에게 책임을 넘기기 위해 POS와 CCTV 시간을 CENTRAL-7 계정으로 조작했다."
      ],
      "characters": [
        {"name":"윤서진","role":"실종된 손님, 불법 거래 발견자"},
        {"name":"박재현","role":"야간 편의점 점장, 실제로는 증거 보호자"},
        {"name":"CENTRAL-7","role":"본사 공용 관리자 계정, 조작 주체"}
      ],
      "puzzles": {
        "receipt_price": {"anomalyItemId":"unknown_item","anomalyCode":"0217","hints":["가격표와 영수증의 금액이 모두 같은지 확인하세요.","실제 상품 목록에 존재하지 않는 네 자리 코드를 찾아보세요."]},
        "barcode_rule": {"segments":["category","shelfPosition","arrivalOrder"],"answer":"994001","hiddenLocation":"냉장고 4번 하단","hints":["바코드 숫자를 한 번에 읽지 말고 구간별로 나누어 보세요.","상품 분류, 진열 위치, 입고 순서가 각각 다른 구간에 들어 있습니다."]},
        "shelf_difference": {"targets":["drink_position","umbrella_count","price_tag_direction","empty_slot","fridge_pouch"],"finalTarget":"fridge_pouch","pouchMessage":"17분 동안만 기록이 남는다.","controlModes":["motion","touch"],"hints":["상품 개수뿐 아니라 가격표와 빈 공간도 비교하세요.","냉장고 아래쪽에 이전 기록에는 없던 물체가 있습니다."]},
        "cctv_sequence": {"recordCount":5,"reveals":"central7_trace","hints":["각 화면의 매장 시계만으로는 순서를 확정할 수 없습니다.","전자레인지와 POS 영수증 출력 상태를 함께 비교하세요."]},
        "inventory_crosscheck": {"discrepancyItemId":"evidence_box","missingCount":1,"location":"냉장고 하단","hints":["현재 재고는 이전 재고에 입고를 더하고 판매를 빼서 계산합니다.","계산 결과와 실제 수량이 1개 차이 나는 상품을 찾으세요."]},
        "customer_pattern": {"cycles":3,"message":"기록은 점장이 지우지 않았다","hints":["손님이 산 상품보다 상품이 놓인 위치에 주목하세요.","각 반복에서 구매한 상품을 진열 순서로 변환하세요."]},
        "incident_timeline": {"eventCount":7,"hints":["기록 시간과 실제 사건 시간이 조작되었을 가능성을 고려하세요.","CENTRAL-7 접속 이후 변경된 기록을 별도로 분리하세요."]}
      },
      "puzzleIds": ["receipt_price","barcode_rule","shelf_difference","cctv_sequence","inventory_crosscheck","customer_pattern","incident_timeline"],
